# Copy to .env.local after creating your Supabase project.
# Never commit .env.local or expose the service-role key in browser code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secrets must never use NEXT_PUBLIC_ prefixes.
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-side Ed25519 signing key in PKCS#8 PEM format; keep it in a secret manager.
FONEZONE_SIGNING_PRIVATE_KEY_PEM=
# Optional Sepolia RPC endpoint. Core workflows must work without it.
SEPOLIA_RPC_URL=

# Keep false on deployments. Demo shortcuts are available automatically in `next dev`.
NEXT_PUBLIC_FONEZONE_DEMO_MODE=false
